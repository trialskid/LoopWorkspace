diff --git a/Loop/LoopTests/LoopWiseMealCaptureTests.swift b/Loop/LoopTests/LoopWiseMealCaptureTests.swift
new file mode 100644
index 0000000..10d734c
--- /dev/null
+++ b/Loop/LoopTests/LoopWiseMealCaptureTests.swift
@@ -0,0 +1,116 @@
+//
+//  LoopWiseMealCaptureTests.swift
+//  LoopTests
+//
+
+import XCTest
+import UIKit
+@testable import Loop
+
+final class LoopWiseMealCaptureTests: XCTestCase {
+    func testMealNoteIsCappedAtFiveHundredCharacters() {
+        let draft = LoopWiseMealCaptureDraft(
+            note: String(repeating: "a", count: 501),
+            photo: nil
+        )
+
+        XCTAssertEqual(500, draft.note.count)
+        XCTAssertTrue(draft.hasContent)
+    }
+
+    func testMealNoteIsSafeForUTF16AndUTF8ServerLimits() {
+        let draft = LoopWiseMealCaptureDraft(
+            note: String(repeating: "😀", count: 300),
+            photo: nil
+        )
+
+        XCTAssertLessThanOrEqual(draft.note.unicodeScalars.count, 500)
+        XCTAssertLessThanOrEqual(draft.note.utf16.count, 500)
+        XCTAssertLessThanOrEqual(draft.note.utf8.count, 3500)
+        XCTAssertEqual(draft.note.utf16.count, LoopWiseMealCaptureDraft.noteCharacterCount(draft.note))
+    }
+
+    func testWhitespaceOnlyNoteDoesNotCreateContent() {
+        let draft = LoopWiseMealCaptureDraft(note: " \n ", photo: nil)
+
+        XCTAssertFalse(draft.hasContent)
+    }
+
+    func testPhotoCreatesContentWithoutNote() {
+        let draft = LoopWiseMealCaptureDraft(note: "", photo: UIImage())
+
+        XCTAssertTrue(draft.hasContent)
+    }
+
+    func testMealPhotoEncodingUsesBoundedPixelAndByteSizes() throws {
+        let source = UIGraphicsImageRenderer(size: CGSize(width: 3000, height: 2400)).image { context in
+            UIColor.orange.setFill()
+            context.cgContext.fill(CGRect(x: 0, y: 0, width: 3000, height: 2400))
+        }
+
+        let encoded = try XCTUnwrap(LoopWiseMealPhotoEncoder.encode(source))
+
+        XCTAssertLessThanOrEqual(encoded.image.cgImage?.width ?? .max, 2048)
+        XCTAssertLessThanOrEqual(encoded.image.cgImage?.height ?? .max, 2048)
+        XCTAssertLessThanOrEqual(encoded.data.count, LoopWiseMealCaptureDraft.maximumPhotoBytes)
+    }
+
+    func testConfigurationRequiresHTTPS() throws {
+        XCTAssertThrowsError(
+            try LoopWiseMealCaptureConfiguration.validatedBaseURL(from: "http://loopwise.example.com")
+        )
+        XCTAssertEqual(
+            try LoopWiseMealCaptureConfiguration.validatedBaseURL(from: "https://loopwise.example.com/").absoluteString,
+            "https://loopwise.example.com"
+        )
+        XCTAssertThrowsError(
+            try LoopWiseMealCaptureConfiguration.validatedBaseURL(from: "https://loopwise.example.com/subpath")
+        )
+    }
+
+    func testDestinationIdentifierBindsCanonicalOriginAndCredential() throws {
+        let canonical = try LoopWiseMealCaptureConfiguration.validatedBaseURL(
+            from: "https://LoopWise.Example.com:443"
+        )
+        let sameOrigin = try LoopWiseMealCaptureConfiguration.validatedBaseURL(
+            from: "https://loopwise.example.com"
+        )
+
+        let first = LoopWiseMealCaptureConfiguration.destinationIdentifier(
+            baseURL: canonical,
+            token: "owner-a-token"
+        )
+        let same = LoopWiseMealCaptureConfiguration.destinationIdentifier(
+            baseURL: sameOrigin,
+            token: "owner-a-token"
+        )
+        let differentCredential = LoopWiseMealCaptureConfiguration.destinationIdentifier(
+            baseURL: sameOrigin,
+            token: "owner-b-token"
+        )
+
+        XCTAssertEqual(first, same)
+        XCTAssertNotEqual(first, differentCredential)
+        XCTAssertFalse(first.contains("owner-a-token"))
+        XCTAssertTrue(LoopWiseMealCaptureManager.destinationMatches(first, current: same))
+        XCTAssertFalse(LoopWiseMealCaptureManager.destinationMatches(first, current: differentCredential))
+        XCTAssertFalse(LoopWiseMealCaptureManager.destinationMatches(nil, current: first))
+        XCTAssertFalse(LoopWiseMealCaptureManager.destinationMatches(nil, current: nil))
+    }
+
+    func testOnlyDocumentedServerResultsAreTerminal() {
+        for result in ["created", "updated", "unchanged", "stale", "discarded"] {
+            XCTAssertTrue(LoopWiseMealCaptureManager.isAllowedTerminalResult(result))
+        }
+        XCTAssertFalse(LoopWiseMealCaptureManager.isAllowedTerminalResult(nil))
+        XCTAssertFalse(LoopWiseMealCaptureManager.isAllowedTerminalResult(""))
+        XCTAssertFalse(LoopWiseMealCaptureManager.isAllowedTerminalResult("ok"))
+    }
+
+    func testRetryAfterIsBounded() {
+        XCTAssertEqual(30, LoopWiseMealCaptureManager.boundedRetryAfterDelay("0"))
+        XCTAssertEqual(900, LoopWiseMealCaptureManager.boundedRetryAfterDelay("900"))
+        XCTAssertEqual(3600, LoopWiseMealCaptureManager.boundedRetryAfterDelay("99999"))
+        XCTAssertNil(LoopWiseMealCaptureManager.boundedRetryAfterDelay("not-a-delay"))
+    }
+}
