+struct LoopWiseMealCaptureSettingsView: View {
+    @ObservedObject private var manager = LoopWiseMealCaptureManager.shared
+
+    @State private var baseURL: String
+    @State private var token = ""
+    @State private var message: String?
+    @State private var showsDisconnectConfirmation = false
+    @State private var showsConnectionChangeConfirmation = false
+    @State private var showsDiscardFailedConfirmation = false
+    @State private var showsDiscardQuarantinedConfirmation = false
+    @State private var showsDiscardAllConfirmation = false
+
+    private let configuration = LoopWiseMealCaptureConfiguration.shared
+
+    init() {
+        _baseURL = State(initialValue: LoopWiseMealCaptureConfiguration.shared.baseURLString)
+    }
+
+    var body: some View {
+        Form {
+            Section(
+                header: Text("Connection"),
+                footer: Text("Use the HTTPS address and write-only meal upload token from LoopWise. The token is stored in the iPhone Keychain.")
+            ) {
+                TextField("https://loopwise.example.com", text: $baseURL)
+                    .textContentType(.URL)
+                    .keyboardType(.URL)
+                    .textInputAutocapitalization(.never)
+                    .disableAutocorrection(true)
+
+                SecureField(
+                    configuration.hasToken ? "Token saved — leave blank to keep it" : "Write-only upload token",
+                    text: $token
+                )
+                .textContentType(.password)
+                .textInputAutocapitalization(.never)
+                .disableAutocorrection(true)
+
+                Button("Save connection") {
+                    save()
+                }
+
+                if configuration.hasToken || !configuration.baseURLString.isEmpty {
+                    Button("Disconnect LoopWise", role: .destructive) {
+                        showsDisconnectConfirmation = true
+                    }
+                }
+            }
+
+            Section(header: Text("Upload status")) {
+                Text(manager.status.message)
+                if manager.status.pendingCount > 0 {
+                    Button("Retry now") {
+                        manager.retryPending()
+                    }
+                }
+                if manager.status.failedCount > 0 {
+                    Button("Retry failed upload") {
+                        manager.retryPending(includingFailed: true)
+                    }
+                    Button("Discard failed uploads", role: .destructive) {
+                        showsDiscardFailedConfirmation = true
+                    }
+                }
+                if manager.status.quarantinedCount > 0 {
+                    Button("Discard uploads for another connection", role: .destructive) {
+                        showsDiscardQuarantinedConfirmation = true
+                    }
+                }
+                if manager.status.storageNeedsAttention {
+                    Button("Discard all saved uploads", role: .destructive) {
+                        showsDiscardAllConfirmation = true
+                    }
+                }
+            }
+
+            if let message {
+                Section {
+                    Text(message)
+                }
+            }
+        }
+        .navigationTitle("LoopWise")
+        .alert("Disconnect LoopWise?", isPresented: $showsDisconnectConfirmation) {
+            Button("Cancel", role: .cancel) {}
+            Button("Disconnect", role: .destructive) {
+                disconnect()
+            }
+        } message: {
+            Text("This removes the saved address and upload token. Saved meal uploads remain quarantined on this iPhone and cannot be sent to another connection. It does not change Loop or delete carb entries.")
+        }
+        .alert("Change LoopWise connection?", isPresented: $showsConnectionChangeConfirmation) {
+            Button("Cancel", role: .cancel) {}
+            Button("Change Connection") {
+                saveConfirmedConnection()
+            }
+        } message: {
+            Text("Existing saved meal uploads will remain quarantined for the original connection and will not be sent to the new one. You can reconnect to the original connection or discard them.")
+        }
+        .alert("Discard failed uploads?", isPresented: $showsDiscardFailedConfirmation) {
+            Button("Cancel", role: .cancel) {}
+            Button("Discard", role: .destructive) {
+                manager.discardFailedUploads()
+            }
+        } message: {
+            Text("This permanently deletes the saved notes and photos for failed uploads. It does not delete carb entries.")
+        }
+        .alert("Discard uploads for another connection?", isPresented: $showsDiscardQuarantinedConfirmation) {
+            Button("Cancel", role: .cancel) {}
+            Button("Discard", role: .destructive) {
+                manager.discardQuarantinedUploads()
+            }
+        } message: {
+            Text("This permanently deletes quarantined notes and photos saved for a different LoopWise connection. It does not delete carb entries.")
+        }
+        .alert("Discard all saved uploads?", isPresented: $showsDiscardAllConfirmation) {
+            Button("Cancel", role: .cancel) {}
+            Button("Discard All", role: .destructive) {
+                manager.discardAllSavedUploads()
+            }
+        } message: {
+            Text("Use this only if saved upload storage cannot be read. It permanently deletes queued notes and photos but does not delete carb entries.")
+        }
+    }
+
+    private func save() {
+        do {
+            let hasSavedUploads = manager.status.pendingCount
+                + manager.status.failedCount
+                + manager.status.quarantinedCount > 0
+                || manager.status.storageNeedsAttention
+            if hasSavedUploads,
+               try configuration.connectionWouldChange(baseURLString: baseURL, token: token)
+            {
+                showsConnectionChangeConfirmation = true
+            } else {
+                saveConfirmedConnection()
+            }
+        } catch {
+            message = error.localizedDescription
+        }
+    }
+
+    private func saveConfirmedConnection() {
+        do {
+            try configuration.save(baseURLString: baseURL, token: token)
+            baseURL = configuration.baseURLString
+            token = ""
+            message = "LoopWise connection saved."
+            manager.configurationDidChange()
+            manager.retryPending()
+        } catch {
+            message = error.localizedDescription
+        }
+    }
+
+    private func disconnect() {
+        do {
+            try configuration.clear()
+            baseURL = ""
+            token = ""
+            message = "LoopWise disconnected. Saved meal uploads remain protected on this iPhone."
+            manager.configurationDidChange()
+        } catch {
+            message = error.localizedDescription
+        }
+    }
+}
