diff --git a/Loop/Loop/Managers/LoopWiseMealCaptureManager.swift b/Loop/Loop/Managers/LoopWiseMealCaptureManager.swift
new file mode 100644
index 0000000..06103b2
--- /dev/null
+++ b/Loop/Loop/Managers/LoopWiseMealCaptureManager.swift
@@ -0,0 +1,1085 @@
+//
+//  LoopWiseMealCaptureManager.swift
+//  Loop
+//
+//  Optional, non-therapy meal documentation upload for LoopWise.
+//
+
+import Combine
+import CryptoKit
+import Foundation
+import LoopKit
+import Security
+import UIKit
+
+struct LoopWiseMealCaptureDraft {
+    static let maximumNoteLength = 500
+    static let maximumNoteUTF8Bytes = 3500
+    static let maximumPhotoBytes = 12 * 1024 * 1024
+
+    let captureID: UUID
+    let note: String
+    let photo: UIImage?
+
+    init(captureID: UUID = UUID(), note: String, photo: UIImage?) {
+        self.captureID = captureID
+        self.note = Self.limitedNote(note)
+        self.photo = photo
+    }
+
+    var hasContent: Bool {
+        !note.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || photo != nil
+    }
+
+    static func limitedNote(_ value: String) -> String {
+        var scalars = String.UnicodeScalarView()
+        var scalarCount = 0
+        var utf8Count = 0
+        var utf16Count = 0
+
+        for scalar in value.unicodeScalars {
+            let scalarUTF8Count = String(scalar).utf8.count
+            let scalarUTF16Count = scalar.value > 0xFFFF ? 2 : 1
+            guard scalarCount < maximumNoteLength,
+                  utf8Count + scalarUTF8Count <= maximumNoteUTF8Bytes,
+                  utf16Count + scalarUTF16Count <= maximumNoteLength
+            else {
+                break
+            }
+            scalars.append(scalar)
+            scalarCount += 1
+            utf8Count += scalarUTF8Count
+            utf16Count += scalarUTF16Count
+        }
+
+        return String(scalars)
+    }
+
+    static func noteCharacterCount(_ value: String) -> Int {
+        limitedNote(value).utf16.count
+    }
+}
+
+enum LoopWiseMealPhotoEncoder {
+    private static let maximumDimension: CGFloat = 2048
+
+    static func encode(_ image: UIImage) -> (image: UIImage, data: Data)? {
+        var targetSize = fittedSize(for: image.size, maximumDimension: maximumDimension)
+
+        for _ in 0..<5 {
+            let format = UIGraphicsImageRendererFormat.default()
+            format.scale = 1
+            let renderer = UIGraphicsImageRenderer(size: targetSize, format: format)
+            let normalizedImage = renderer.image { _ in
+                image.draw(in: CGRect(origin: .zero, size: targetSize))
+            }
+
+            for quality in [0.82, 0.7, 0.55, 0.4, 0.25] {
+                if let data = normalizedImage.jpegData(compressionQuality: quality),
+                   data.count <= LoopWiseMealCaptureDraft.maximumPhotoBytes
+                {
+                    return (normalizedImage, data)
+                }
+            }
+
+            targetSize = CGSize(
+                width: max(1, floor(targetSize.width * 0.75)),
+                height: max(1, floor(targetSize.height * 0.75))
+            )
+        }
+
+        return nil
+    }
+
+    private static func fittedSize(for size: CGSize, maximumDimension: CGFloat) -> CGSize {
+        let largestDimension = max(size.width, size.height)
+        guard largestDimension > 0 else {
+            return CGSize(width: 1, height: 1)
+        }
+        let scale = min(1, maximumDimension / largestDimension)
+        return CGSize(
+            width: max(1, floor(size.width * scale)),
+            height: max(1, floor(size.height * scale))
+        )
+    }
+}
+
+protocol LoopWiseMealCaptureEnqueuing {
+    func enqueue(_ draft: LoopWiseMealCaptureDraft, for carbEntry: StoredCarbEntry)
+}
+
+struct LoopWiseMealCaptureStatus: Equatable {
+    var pendingCount: Int
+    var failedCount: Int
+    var quarantinedCount: Int
+    var storageNeedsAttention: Bool
+    var message: String
+}
+
+enum LoopWiseMealCaptureConfigurationError: LocalizedError {
+    case invalidURL
+    case missingToken
+    case keychain(OSStatus)
+
+    var errorDescription: String? {
+        switch self {
+        case .invalidURL:
+            return "Enter a valid HTTPS LoopWise address."
+        case .missingToken:
+            return "Enter the write-only meal upload token from LoopWise."
+        case .keychain:
+            return "The upload token could not be updated securely."
+        }
+    }
+}
+
+final class LoopWiseMealCaptureConfiguration {
+    static let shared = LoopWiseMealCaptureConfiguration()
+
+    private let defaultsKey = "com.loopkit.Loop.loopwiseMealCapture.baseURL"
+    private let keychainService = "com.loopkit.Loop.loopwiseMealCapture"
+    private let keychainAccount = "write-only-upload-token"
+
+    private init() {}
+
+    var baseURLString: String {
+        UserDefaults.standard.string(forKey: defaultsKey) ?? ""
+    }
+
+    var hasToken: Bool {
+        token != nil
+    }
+
+    fileprivate var token: String? {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: keychainAccount,
+            kSecReturnData as String: true,
+            kSecMatchLimit as String: kSecMatchLimitOne
+        ]
+        var item: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess,
+              let data = item as? Data,
+              let value = String(data: data, encoding: .utf8),
+              !value.isEmpty
+        else {
+            return nil
+        }
+        return value
+    }
+
+    var destinationIdentifier: String? {
+        guard let token,
+              let baseURL = try? Self.validatedBaseURL(from: baseURLString)
+        else {
+            return nil
+        }
+        return Self.destinationIdentifier(baseURL: baseURL, token: token)
+    }
+
+    var isConfigured: Bool {
+        destinationIdentifier != nil
+    }
+
+    func connectionWouldChange(baseURLString: String, token newToken: String?) throws -> Bool {
+        let baseURL = try Self.validatedBaseURL(from: baseURLString)
+        let trimmedToken = newToken?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        let effectiveToken: String
+        if trimmedToken.isEmpty {
+            guard let token else {
+                throw LoopWiseMealCaptureConfigurationError.missingToken
+            }
+            effectiveToken = token
+        } else {
+            effectiveToken = trimmedToken
+        }
+        return Self.destinationIdentifier(baseURL: baseURL, token: effectiveToken) != destinationIdentifier
+    }
+
+    func save(baseURLString: String, token newToken: String?) throws {
+        let normalizedURL = try Self.validatedBaseURL(from: baseURLString)
+        let trimmedToken = newToken?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+
+        if !trimmedToken.isEmpty {
+            try saveToken(trimmedToken)
+        } else if token == nil {
+            throw LoopWiseMealCaptureConfigurationError.missingToken
+        }
+
+        UserDefaults.standard.set(normalizedURL.absoluteString, forKey: defaultsKey)
+    }
+
+    func clear() throws {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: keychainAccount
+        ]
+        let status = SecItemDelete(query as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else {
+            throw LoopWiseMealCaptureConfigurationError.keychain(status)
+        }
+        UserDefaults.standard.removeObject(forKey: defaultsKey)
+    }
+
+    static func validatedBaseURL(from value: String) throws -> URL {
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard var components = URLComponents(string: trimmed),
+              components.scheme?.lowercased() == "https",
+              components.host?.isEmpty == false,
+              components.user == nil,
+              components.password == nil,
+              components.query == nil,
+              components.fragment == nil,
+              components.path.isEmpty || components.path == "/"
+        else {
+            throw LoopWiseMealCaptureConfigurationError.invalidURL
+        }
+        components.path = ""
+        guard let url = components.url else {
+            throw LoopWiseMealCaptureConfigurationError.invalidURL
+        }
+        return url
+    }
+
+    static func destinationIdentifier(baseURL: URL, token: String) -> String {
+        let components = URLComponents(url: baseURL, resolvingAgainstBaseURL: false)
+        let scheme = components?.scheme?.lowercased() ?? "https"
+        let host = components?.host?.lowercased() ?? ""
+        let port = components?.port
+        let normalizedPort = port == 443 ? nil : port
+        let origin = normalizedPort.map { "\(scheme)://\(host):\($0)" } ?? "\(scheme)://\(host)"
+        let credentialFingerprint = SHA256.hash(data: Data(token.utf8))
+            .map { String(format: "%02x", $0) }
+            .joined()
+        return "\(origin)|\(credentialFingerprint)"
+    }
+
+    private func saveToken(_ token: String) throws {
+        let data = Data(token.utf8)
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: keychainAccount
+        ]
+        let attributes: [String: Any] = [
+            kSecValueData as String: data,
+            kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        ]
+
+        let status: OSStatus
+        if SecItemCopyMatching(query as CFDictionary, nil) == errSecSuccess {
+            status = SecItemUpdate(query as CFDictionary, attributes as CFDictionary)
+        } else {
+            var addQuery = query
+            attributes.forEach { addQuery[$0.key] = $0.value }
+            status = SecItemAdd(addQuery as CFDictionary, nil)
+        }
+        guard status == errSecSuccess else {
+            throw LoopWiseMealCaptureConfigurationError.keychain(status)
+        }
+    }
+}
+
+final class LoopWiseMealCaptureManager: ObservableObject, LoopWiseMealCaptureEnqueuing {
+    static let shared = LoopWiseMealCaptureManager()
+
+    static func destinationMatches(_ saved: String?, current: String?) -> Bool {
+        guard let current else { return false }
+        return saved == current
+    }
+
+    static func isAllowedTerminalResult(_ value: String?) -> Bool {
+        guard let value else { return false }
+        return ["created", "updated", "unchanged", "stale", "discarded"].contains(value)
+    }
+
+    static func boundedRetryAfterDelay(_ value: String?, now: Date = Date()) -> TimeInterval? {
+        guard let value = value?.trimmingCharacters(in: .whitespacesAndNewlines),
+              !value.isEmpty
+        else {
+            return nil
+        }
+
+        let rawDelay: TimeInterval?
+        if let seconds = TimeInterval(value), seconds.isFinite {
+            rawDelay = seconds
+        } else {
+            let formats = [
+                "EEE',' dd MMM yyyy HH':'mm':'ss zzz",
+                "EEEE',' dd-MMM-yy HH':'mm':'ss zzz",
+                "EEE MMM d HH':'mm':'ss yyyy"
+            ]
+            rawDelay = formats.compactMap { format -> TimeInterval? in
+                let formatter = DateFormatter()
+                formatter.locale = Locale(identifier: "en_US_POSIX")
+                formatter.timeZone = TimeZone(secondsFromGMT: 0)
+                formatter.dateFormat = format
+                return formatter.date(from: value)?.timeIntervalSince(now)
+            }.first
+        }
+
+        guard let rawDelay else { return nil }
+        return min(max(rawDelay, 30), 3600)
+    }
+
+    @Published private(set) var status = LoopWiseMealCaptureStatus(
+        pendingCount: 0,
+        failedCount: 0,
+        quarantinedCount: 0,
+        storageNeedsAttention: false,
+        message: "No meal uploads are waiting."
+    )
+
+    private struct Metadata: Codable {
+        let schemaVersion: String
+        let captureId: UUID
+        let carbSyncIdentifier: String
+        let carbSyncVersion: Int
+        let mealStart: Date
+        let note: String
+
+        private enum CodingKeys: String, CodingKey {
+            case schemaVersion
+            case captureId
+            case carbSyncIdentifier
+            case carbSyncVersion
+            case mealStart
+            case note
+        }
+
+        func encode(to encoder: Encoder) throws {
+            var container = encoder.container(keyedBy: CodingKeys.self)
+            try container.encode(schemaVersion, forKey: .schemaVersion)
+            try container.encode(captureId, forKey: .captureId)
+            try container.encode(carbSyncIdentifier, forKey: .carbSyncIdentifier)
+            try container.encode(carbSyncVersion, forKey: .carbSyncVersion)
+            try container.encode(mealStart, forKey: .mealStart)
+            try container.encode(note, forKey: .note)
+        }
+    }
+
+    private struct PendingCapture: Codable {
+        enum State: String, Codable {
+            case queued
+            case failed
+        }
+
+        let metadata: Metadata
+        let destinationIdentifier: String?
+        let photoFilename: String?
+        var attemptCount: Int
+        var nextAttemptDate: Date?
+        var state: State
+    }
+
+    private struct UploadResponse: Decodable {
+        let result: String?
+    }
+
+    private enum QueueStoreError: Error {
+        case createDirectory
+        case protectStorage
+        case readQueue
+        case decodeQueue
+        case encodeQueue
+        case writeQueue
+        case inspectPhoto
+        case removePhoto
+    }
+
+    private let workerQueue = DispatchQueue(label: "com.loopkit.Loop.loopwiseMealCapture", qos: .utility)
+    private let configuration = LoopWiseMealCaptureConfiguration.shared
+    private let fileManager = FileManager.default
+    private let maximumQueueCount = 50
+    private let maximumPersistedPhotoBytes = 48 * 1024 * 1024
+    private var isUploading = false
+    private var activeUploadTask: URLSessionDataTask?
+    private var activeCaptureID: UUID?
+    private var storageErrorMessage: String?
+    private lazy var directoryURL: URL = {
+        let support = fileManager.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        return support.appendingPathComponent("LoopWiseMealCaptureQueue", isDirectory: true)
+    }()
+    private lazy var queueURL = directoryURL.appendingPathComponent("queue.json")
+
+    private init() {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                try self.ensureDirectory()
+                self.publishStatus()
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    func start() {
+        retryPending()
+    }
+
+    func enqueue(_ draft: LoopWiseMealCaptureDraft, for carbEntry: StoredCarbEntry) {
+        guard draft.hasContent,
+              let syncIdentifier = carbEntry.syncIdentifier,
+              let syncVersion = carbEntry.syncVersion
+        else {
+            return
+        }
+
+        let metadata = Metadata(
+            schemaVersion: "loop-meal-capture-v1",
+            captureId: draft.captureID,
+            carbSyncIdentifier: syncIdentifier,
+            carbSyncVersion: syncVersion,
+            mealStart: carbEntry.startDate,
+            note: draft.note
+        )
+
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                try self.ensureDirectory()
+                var captures = try self.loadQueue()
+                guard let destinationIdentifier = self.configuration.destinationIdentifier else {
+                    self.publishStatus(
+                        captures: captures,
+                        message: "Connect LoopWise before saving optional meal notes or photos."
+                    )
+                    return
+                }
+                guard !captures.contains(where: { $0.metadata.captureId == draft.captureID }) else {
+                    self.processNext()
+                    return
+                }
+                guard captures.count < self.maximumQueueCount else {
+                    self.publishStatus(
+                        captures: captures,
+                        message: "Meal details were not queued because the saved upload limit was reached. Retry or discard uploads in LoopWise settings."
+                    )
+                    return
+                }
+                let photoData: Data?
+                if let photo = draft.photo {
+                    guard let encoded = LoopWiseMealPhotoEncoder.encode(photo) else {
+                        self.publishStatus(
+                            captures: captures,
+                            message: "The meal photo could not be prepared for upload. Choose another photo."
+                        )
+                        return
+                    }
+                    photoData = encoded.data
+                    let currentPhotoBytes = try self.persistedPhotoBytes(for: captures)
+                    guard currentPhotoBytes + encoded.data.count <= self.maximumPersistedPhotoBytes else {
+                        self.publishStatus(
+                            captures: captures,
+                            message: "Meal details were not queued because saved photos reached their storage limit. Retry or discard uploads in LoopWise settings."
+                        )
+                        return
+                    }
+                } else {
+                    photoData = nil
+                }
+
+                var photoFilename: String?
+                if let photoData {
+                    let filename = "\(draft.captureID.uuidString).jpg"
+                    let url = self.directoryURL.appendingPathComponent(filename)
+                    do {
+                        try photoData.write(to: url, options: .atomic)
+                        try self.protectAndExcludeFromBackup(url)
+                        photoFilename = filename
+                    } catch {
+                        try? self.fileManager.removeItem(at: url)
+                        throw QueueStoreError.writeQueue
+                    }
+                }
+
+                captures.append(PendingCapture(
+                    metadata: metadata,
+                    destinationIdentifier: destinationIdentifier,
+                    photoFilename: photoFilename,
+                    attemptCount: 0,
+                    nextAttemptDate: nil,
+                    state: .queued
+                ))
+                do {
+                    try self.saveQueue(captures)
+                } catch {
+                    throw error
+                }
+                self.publishStatus(captures: captures, message: "Meal details are waiting to upload.")
+                self.processNext()
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    func retryPending(includingFailed: Bool = false) {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                var captures = try self.loadQueue()
+                var changed = false
+                guard let currentDestinationIdentifier = self.configuration.destinationIdentifier else {
+                    self.publishStatus(captures: captures)
+                    return
+                }
+                for index in captures.indices
+                    where Self.destinationMatches(
+                        captures[index].destinationIdentifier,
+                        current: currentDestinationIdentifier
+                    )
+                        && (captures[index].state == .queued || includingFailed)
+                {
+                    captures[index].state = .queued
+                    captures[index].nextAttemptDate = nil
+                    changed = true
+                }
+                if changed {
+                    try self.saveQueue(captures)
+                }
+                self.processNext()
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    func configurationDidChange() {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            self.activeUploadTask?.cancel()
+            self.activeUploadTask = nil
+            self.activeCaptureID = nil
+            self.isUploading = false
+            self.publishStatus()
+            self.processNext()
+        }
+    }
+
+    func discardFailedUploads() {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                let captures = try self.loadQueue()
+                let failed = captures.filter { $0.state == .failed }
+                guard !failed.isEmpty else {
+                    self.publishStatus(captures: captures)
+                    return
+                }
+                let remaining = captures.filter { $0.state != .failed }
+                try self.saveQueue(remaining)
+                try self.removePhotos(for: failed)
+                self.publishStatus(captures: remaining, message: "Failed meal uploads were discarded.")
+                self.processNext()
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    func discardAllSavedUploads() {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                try self.ensureDirectory()
+                if self.fileManager.fileExists(atPath: self.queueURL.path) {
+                    try self.fileManager.removeItem(at: self.queueURL)
+                }
+                try self.removeAllSafePhotoFiles()
+                self.storageErrorMessage = nil
+                self.publishStatus(captures: [], message: "Saved meal uploads were discarded.")
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    func discardQuarantinedUploads() {
+        workerQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                let currentDestinationIdentifier = self.configuration.destinationIdentifier
+                let captures = try self.loadQueue()
+                let quarantined = captures.filter {
+                    !Self.destinationMatches(
+                        $0.destinationIdentifier,
+                        current: currentDestinationIdentifier
+                    )
+                }
+                guard !quarantined.isEmpty else {
+                    self.publishStatus(captures: captures)
+                    return
+                }
+                let remaining = captures.filter {
+                    Self.destinationMatches(
+                        $0.destinationIdentifier,
+                        current: currentDestinationIdentifier
+                    )
+                }
+                try self.saveQueue(remaining)
+                try self.removePhotos(for: quarantined)
+                self.publishStatus(
+                    captures: remaining,
+                    message: "Meal uploads for another connection were discarded."
+                )
+                self.processNext()
+            } catch {
+                self.reportStorageError()
+            }
+        }
+    }
+
+    private func processNext() {
+        dispatchPrecondition(condition: .onQueue(workerQueue))
+        guard !isUploading else { return }
+        guard let token = configuration.token,
+              !configuration.baseURLString.isEmpty,
+              let baseURL = try? LoopWiseMealCaptureConfiguration.validatedBaseURL(from: configuration.baseURLString),
+              let currentDestinationIdentifier = configuration.destinationIdentifier
+        else {
+            publishStatus()
+            return
+        }
+
+        let captures: [PendingCapture]
+        do {
+            captures = try loadQueue()
+        } catch {
+            reportStorageError()
+            return
+        }
+        let now = Date()
+        guard let index = captures.firstIndex(where: {
+            Self.destinationMatches(
+                $0.destinationIdentifier,
+                current: currentDestinationIdentifier
+            )
+                && $0.state == .queued
+                && ($0.nextAttemptDate == nil || $0.nextAttemptDate! <= now)
+        }) else {
+            publishStatus()
+            return
+        }
+
+        let capture = captures[index]
+        let endpoint = baseURL.appendingPathComponent("api/mobile/meal-captures")
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 60
+        request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+        request.setValue(capture.metadata.captureId.uuidString, forHTTPHeaderField: "Idempotency-Key")
+
+        let boundary = "LoopWise-\(UUID().uuidString)"
+        request.setValue("multipart/form-data; boundary=\(boundary)", forHTTPHeaderField: "Content-Type")
+        do {
+            request.httpBody = try multipartBody(for: capture, boundary: boundary)
+        } catch {
+            markCaptureFailed(
+                captureID: capture.metadata.captureId,
+                message: "A saved meal upload could not be prepared. Retry or discard it in LoopWise settings."
+            )
+            return
+        }
+        isUploading = true
+        publishStatus(message: "Uploading saved meal details…")
+
+        let task = URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
+            self?.workerQueue.async {
+                self?.handleCompletion(
+                    captureID: capture.metadata.captureId,
+                    data: data,
+                    response: response,
+                    error: error
+                )
+            }
+        }
+        activeUploadTask = task
+        activeCaptureID = capture.metadata.captureId
+        task.resume()
+    }
+
+    private func handleCompletion(captureID: UUID, data: Data?, response: URLResponse?, error: Error?) {
+        dispatchPrecondition(condition: .onQueue(workerQueue))
+        if activeCaptureID == captureID {
+            isUploading = false
+            activeUploadTask = nil
+            activeCaptureID = nil
+        }
+        var captures: [PendingCapture]
+        do {
+            captures = try loadQueue()
+        } catch {
+            reportStorageError()
+            return
+        }
+        guard let index = captures.firstIndex(where: { $0.metadata.captureId == captureID }) else {
+            processNext()
+            return
+        }
+
+        let httpResponse = response as? HTTPURLResponse
+        let statusCode = httpResponse?.statusCode
+        let decodedResponse = data.flatMap {
+            try? JSONDecoder().decode(UploadResponse.self, from: $0)
+        }
+        let serverResult = decodedResponse?.result
+        let hasValidTerminalResult = Self.isAllowedTerminalResult(serverResult)
+        let successfulResponse = statusCode == 410
+            || (error == nil && (statusCode == 200 || statusCode == 201) && hasValidTerminalResult)
+        if successfulResponse {
+            let completed = captures.remove(at: index)
+            do {
+                try saveQueue(captures)
+                try removePhotos(for: [completed])
+                let wasDiscarded = statusCode == 410 || serverResult == "discarded"
+                publishStatus(
+                    captures: captures,
+                    message: wasDiscarded
+                        ? "A deleted meal upload was removed from this iPhone."
+                        : "Meal details uploaded to LoopWise."
+                )
+            } catch {
+                reportStorageError()
+            }
+            processNext()
+            return
+        }
+
+        let malformedSuccessResponse = (statusCode == 200 || statusCode == 201)
+            && !hasValidTerminalResult
+        let shouldRetry = error != nil
+            || malformedSuccessResponse
+            || statusCode == 408
+            || statusCode == 429
+            || (statusCode.map { 500...599 ~= $0 } ?? false)
+        if shouldRetry {
+            captures[index].attemptCount += 1
+            let fallbackDelay = min(pow(2, Double(captures[index].attemptCount)) * 30, 3600)
+            let delay: TimeInterval
+            if statusCode == 429 {
+                delay = Self.boundedRetryAfterDelay(
+                    httpResponse?.value(forHTTPHeaderField: "Retry-After")
+                ) ?? fallbackDelay
+            } else {
+                delay = fallbackDelay
+            }
+            captures[index].nextAttemptDate = Date().addingTimeInterval(delay)
+            captures[index].state = .queued
+            do {
+                try saveQueue(captures)
+                publishStatus(captures: captures, message: "Meal upload will retry automatically.")
+            } catch {
+                reportStorageError()
+                return
+            }
+            workerQueue.asyncAfter(deadline: .now() + delay) { [weak self] in
+                self?.processNext()
+            }
+            processNext()
+        } else {
+            captures[index].state = .failed
+            captures[index].nextAttemptDate = nil
+            do {
+                try saveQueue(captures)
+                publishStatus(
+                    captures: captures,
+                    message: "A meal upload needs attention in LoopWise settings."
+                )
+                processNext()
+            } catch {
+                reportStorageError()
+            }
+        }
+    }
+
+    private func markCaptureFailed(captureID: UUID, message: String) {
+        dispatchPrecondition(condition: .onQueue(workerQueue))
+        do {
+            var captures = try loadQueue()
+            guard let index = captures.firstIndex(where: { $0.metadata.captureId == captureID }) else {
+                processNext()
+                return
+            }
+            captures[index].state = .failed
+            captures[index].nextAttemptDate = nil
+            try saveQueue(captures)
+            publishStatus(captures: captures, message: message)
+            processNext()
+        } catch {
+            reportStorageError()
+        }
+    }
+
+    private func multipartBody(for capture: PendingCapture, boundary: String) throws -> Data {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        let metadataData: Data
+        do {
+            metadataData = try encoder.encode(capture.metadata)
+        } catch {
+            throw QueueStoreError.encodeQueue
+        }
+        var body = Data()
+        body.appendUTF8("--\(boundary)\r\n")
+        body.appendUTF8("Content-Disposition: form-data; name=\"metadata\"\r\n")
+        body.appendUTF8("Content-Type: application/json\r\n\r\n")
+        body.append(metadataData)
+        body.appendUTF8("\r\n")
+
+        if let filename = capture.photoFilename {
+            let photoData: Data
+            do {
+                photoData = try Data(contentsOf: directoryURL.appendingPathComponent(filename))
+            } catch {
+                throw QueueStoreError.readQueue
+            }
+            guard photoData.count <= LoopWiseMealCaptureDraft.maximumPhotoBytes else {
+                throw QueueStoreError.inspectPhoto
+            }
+            body.appendUTF8("--\(boundary)\r\n")
+            body.appendUTF8("Content-Disposition: form-data; name=\"photo\"; filename=\"meal.jpg\"\r\n")
+            body.appendUTF8("Content-Type: image/jpeg\r\n\r\n")
+            body.append(photoData)
+            body.appendUTF8("\r\n")
+        }
+        body.appendUTF8("--\(boundary)--\r\n")
+        return body
+    }
+
+    private func ensureDirectory() throws {
+        do {
+            try fileManager.createDirectory(
+                at: directoryURL,
+                withIntermediateDirectories: true,
+                attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication]
+            )
+            try protectAndExcludeFromBackup(directoryURL)
+        } catch {
+            throw QueueStoreError.createDirectory
+        }
+    }
+
+    private func loadQueue() throws -> [PendingCapture] {
+        guard fileManager.fileExists(atPath: queueURL.path) else {
+            try cleanSafeOrphanedPhotos(referencedFilenames: [])
+            return []
+        }
+
+        let data: Data
+        do {
+            data = try Data(contentsOf: queueURL)
+        } catch {
+            throw QueueStoreError.readQueue
+        }
+
+        let captures: [PendingCapture]
+        do {
+            captures = try JSONDecoder().decode([PendingCapture].self, from: data)
+        } catch {
+            throw QueueStoreError.decodeQueue
+        }
+        guard captures.count <= maximumQueueCount else {
+            throw QueueStoreError.decodeQueue
+        }
+
+        try cleanSafeOrphanedPhotos(
+            referencedFilenames: Set(captures.compactMap(\.photoFilename))
+        )
+        guard try persistedPhotoBytes(for: captures) <= maximumPersistedPhotoBytes else {
+            throw QueueStoreError.inspectPhoto
+        }
+        return captures
+    }
+
+    private func saveQueue(_ captures: [PendingCapture]) throws {
+        let data: Data
+        do {
+            data = try JSONEncoder().encode(captures)
+        } catch {
+            throw QueueStoreError.encodeQueue
+        }
+        do {
+            try data.write(to: queueURL, options: .atomic)
+            try protectAndExcludeFromBackup(queueURL)
+        } catch {
+            throw QueueStoreError.writeQueue
+        }
+        storageErrorMessage = nil
+    }
+
+    private func persistedPhotoBytes(for captures: [PendingCapture]) throws -> Int {
+        var total = 0
+        for filename in captures.compactMap(\.photoFilename) {
+            guard isSafePhotoFilename(filename) else {
+                throw QueueStoreError.inspectPhoto
+            }
+            let url = directoryURL.appendingPathComponent(filename)
+            let values: URLResourceValues
+            do {
+                values = try url.resourceValues(forKeys: [.fileSizeKey, .isRegularFileKey])
+            } catch {
+                throw QueueStoreError.inspectPhoto
+            }
+            guard values.isRegularFile == true, let fileSize = values.fileSize else {
+                throw QueueStoreError.inspectPhoto
+            }
+            let (nextTotal, overflow) = total.addingReportingOverflow(fileSize)
+            guard !overflow else {
+                throw QueueStoreError.inspectPhoto
+            }
+            total = nextTotal
+        }
+        return total
+    }
+
+    private func cleanSafeOrphanedPhotos(referencedFilenames: Set<String>) throws {
+        guard fileManager.fileExists(atPath: directoryURL.path) else { return }
+        let files: [URL]
+        do {
+            files = try fileManager.contentsOfDirectory(
+                at: directoryURL,
+                includingPropertiesForKeys: [.isRegularFileKey],
+                options: [.skipsHiddenFiles]
+            )
+        } catch {
+            throw QueueStoreError.inspectPhoto
+        }
+
+        for file in files {
+            let filename = file.lastPathComponent
+            guard isSafePhotoFilename(filename), !referencedFilenames.contains(filename) else {
+                continue
+            }
+            do {
+                try fileManager.removeItem(at: file)
+            } catch {
+                throw QueueStoreError.removePhoto
+            }
+        }
+    }
+
+    private func removePhotos(for captures: [PendingCapture]) throws {
+        for filename in captures.compactMap(\.photoFilename) {
+            guard isSafePhotoFilename(filename) else {
+                throw QueueStoreError.inspectPhoto
+            }
+            let url = directoryURL.appendingPathComponent(filename)
+            guard fileManager.fileExists(atPath: url.path) else { continue }
+            do {
+                try fileManager.removeItem(at: url)
+            } catch {
+                throw QueueStoreError.removePhoto
+            }
+        }
+    }
+
+    private func removeAllSafePhotoFiles() throws {
+        guard fileManager.fileExists(atPath: directoryURL.path) else { return }
+        let files: [URL]
+        do {
+            files = try fileManager.contentsOfDirectory(
+                at: directoryURL,
+                includingPropertiesForKeys: nil,
+                options: [.skipsHiddenFiles]
+            )
+        } catch {
+            throw QueueStoreError.inspectPhoto
+        }
+        for file in files where isSafePhotoFilename(file.lastPathComponent) {
+            do {
+                try fileManager.removeItem(at: file)
+            } catch {
+                throw QueueStoreError.removePhoto
+            }
+        }
+    }
+
+    private func isSafePhotoFilename(_ filename: String) -> Bool {
+        let url = URL(fileURLWithPath: filename)
+        return url.pathExtension.lowercased() == "jpg"
+            && UUID(uuidString: url.deletingPathExtension().lastPathComponent) != nil
+            && url.lastPathComponent == filename
+    }
+
+    private func protectAndExcludeFromBackup(_ url: URL) throws {
+        do {
+            try fileManager.setAttributes(
+                [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication],
+                ofItemAtPath: url.path
+            )
+            var values = URLResourceValues()
+            values.isExcludedFromBackup = true
+            var mutableURL = url
+            try mutableURL.setResourceValues(values)
+        } catch {
+            throw QueueStoreError.protectStorage
+        }
+    }
+
+    private func reportStorageError() {
+        storageErrorMessage = "Saved meal upload storage needs attention. Restart Loop. If this continues, discard saved uploads in LoopWise settings."
+        DispatchQueue.main.async {
+            self.status = LoopWiseMealCaptureStatus(
+                pendingCount: self.status.pendingCount,
+                failedCount: self.status.failedCount,
+                quarantinedCount: self.status.quarantinedCount,
+                storageNeedsAttention: true,
+                message: self.storageErrorMessage ?? "Saved meal upload storage needs attention."
+            )
+        }
+    }
+
+    private func publishStatus(message: String? = nil) {
+        do {
+            publishStatus(captures: try loadQueue(), message: message)
+        } catch {
+            reportStorageError()
+        }
+    }
+
+    private func publishStatus(captures: [PendingCapture], message: String? = nil) {
+        let currentDestinationIdentifier = configuration.destinationIdentifier
+        let matchesCurrentDestination: (PendingCapture) -> Bool = {
+            Self.destinationMatches(
+                $0.destinationIdentifier,
+                current: currentDestinationIdentifier
+            )
+        }
+        let pending = captures.filter {
+            matchesCurrentDestination($0) && $0.state == .queued
+        }.count
+        let failed = captures.filter {
+            matchesCurrentDestination($0) && $0.state == .failed
+        }.count
+        let quarantined = captures.filter { !matchesCurrentDestination($0) }.count
+        let fallback: String
+        if failed > 0 {
+            fallback = "\(failed) meal upload\(failed == 1 ? "" : "s") need attention."
+        } else if pending > 0 {
+            fallback = "\(pending) meal upload\(pending == 1 ? "" : "s") waiting."
+        } else if quarantined > 0 {
+            fallback = "\(quarantined) saved meal upload\(quarantined == 1 ? "" : "s") belong to another connection and will not be sent."
+        } else {
+            fallback = "No meal uploads are waiting."
+        }
+        DispatchQueue.main.async {
+            self.status = LoopWiseMealCaptureStatus(
+                pendingCount: pending,
+                failedCount: failed,
+                quarantinedCount: quarantined,
+                storageNeedsAttention: self.storageErrorMessage != nil,
+                message: self.storageErrorMessage ?? message ?? fallback
+            )
+        }
+    }
+}
+
+private extension Data {
+    mutating func appendUTF8(_ value: String) {
+        append(Data(value.utf8))
+    }
+}
